ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Local dev (docker-compose Postgres):
DATABASE_URL=postgresql://tcuser:tcpassword@localhost:5432/training_companion
#
# Staging / production (Supabase): use the SESSION POOLER string from
# Supabase -> Project Settings -> Database -> Connection string. It is IPv4 and
# safe for a long-lived FastAPI container on Railway. Append sslmode=require.
# Example shape (do NOT commit the real one):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase (auth) ----------------------------------------------------------
# Project URL from: Project Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co
# JWT signing keys are fetched automatically from:
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json — no secret needed in env.

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. "*" is fine for local dev;
# restrict to your real domains in production.
CORS_ORIGINS=*

# --- Error tracking -----------------------------------------------------------
SENTRY_DSN=
